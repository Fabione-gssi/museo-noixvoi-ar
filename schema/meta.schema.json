{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.schema.json",
  "title": "Quadro (meta.json generato dalla pipeline)",
  "type": "object",
  "required": ["schemaVersion", "id", "order", "title", "experience", "aspect", "image", "targets", "dettagli", "demo"],
  "additionalProperties": false,
  "definitions": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "segment": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": { "from": { "type": "number", "minimum": 0 }, "to": { "type": "number", "minimum": 0 } }
    },
    "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string" },
    "year": { "type": "string" },
    "room": { "type": "string" },
    "experience": { "enum": ["dettagli", "caccia", "personaggio", "racconto"] },
    "demo": { "type": "boolean", "description": "true se l'audio è la voce sintetica DEMO" },
    "aspect": { "type": "number", "exclusiveMinimum": 0 },
    "image": { "$ref": "#/definitions/file" },
    "depth": { "$ref": "#/definitions/file" },
    "audio": {
      "type": "object",
      "required": ["src", "fallback", "durationSec"],
      "additionalProperties": false,
      "properties": {
        "src": { "$ref": "#/definitions/file" },
        "fallback": { "$ref": "#/definitions/file" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "subtitles": { "$ref": "#/definitions/file" },
    "alignment": { "$ref": "#/definitions/file" },
    "targets": {
      "type": "object",
      "required": ["mind", "main"],
      "additionalProperties": false,
      "properties": {
        "mind": { "$ref": "#/definitions/file" },
        "main": {
          "type": "object",
          "required": ["targetIndex", "image", "points"],
          "additionalProperties": false,
          "properties": { "targetIndex": { "const": 0 }, "image": { "$ref": "#/definitions/file" }, "points": { "type": "integer" } }
        }
      }
    },
    "dettagli": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "crop", "trigger"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "crop": { "$ref": "#/definitions/rect" },
          "targetIndex": { "type": "integer", "minimum": 1 },
          "image": { "$ref": "#/definitions/file" },
          "points": { "type": "integer" },
          "trigger": { "type": "array", "items": { "enum": ["target", "reticle"] } },
          "audioSegment": { "$ref": "#/definitions/segment" },
          "source": { "type": "string" }
        }
      }
    },
    "racconto": {
      "type": "object",
      "required": ["auto", "timeline"],
      "additionalProperties": false,
      "properties": {
        "auto": { "type": "boolean" },
        "video": {
          "type": "object",
          "required": ["src"],
          "additionalProperties": false,
          "properties": { "src": { "$ref": "#/definitions/file" }, "fallback": { "$ref": "#/definitions/file" } }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "action", "args"],
            "additionalProperties": false,
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "action": { "enum": ["cameraTo", "highlight"] },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "rect": { "$ref": "#/definitions/rect" }, "label": { "type": "string" }, "id": { "type": "string" } }
              },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": { "bytes": { "type": "integer" }, "limit": { "type": "integer" } }
    }
  }
}
