{"source":"tts","voice":"piper it_IT-serena-medium","durationSec":62.745,"sentences":[{"text":"Sono Albrecht Dürer, di Norimberga.","start":0,"end":2.078,"words":[{"w":"Sono","start":0,"end":0.306},{"w":"Albrecht","start":0.306,"end":0.856},{"w":"Dürer","start":0.856,"end":1.222},{"w":"di","start":1.222,"end":1.406},{"w":"Norimberga","start":1.406,"end":2.078}],"paragraph":0},{"text":"Questo ritratto l'ho dipinto nel 1500, a olio su tavola.","start":2.528,"end":6.464,"words":[{"w":"Questo","start":2.528,"end":3.029},{"w":"ritratto","start":3.029,"end":3.673},{"w":"l'ho","start":3.673,"end":4.031},{"w":"dipinto","start":4.031,"end":4.603},{"w":"nel","start":4.603,"end":4.89},{"w":"1500","start":4.89,"end":5.247},{"w":"a","start":5.247,"end":5.391},{"w":"olio","start":5.391,"end":5.748},{"w":"su","start":5.748,"end":5.963},{"w":"tavola","start":5.963,"end":6.464}],"paragraph":0},{"text":"Mi vedi di fronte, mentre ti guardo dritto negli occhi.","start":7.364,"end":10.417,"words":[{"w":"Mi","start":7.364,"end":7.534},{"w":"vedi","start":7.534,"end":7.816},{"w":"di","start":7.816,"end":7.986},{"w":"fronte","start":7.986,"end":8.382},{"w":"mentre","start":8.382,"end":8.778},{"w":"ti","start":8.778,"end":8.947},{"w":"guardo","start":8.947,"end":9.343},{"w":"dritto","start":9.343,"end":9.739},{"w":"negli","start":9.739,"end":10.078},{"w":"occhi","start":10.078,"end":10.417}],"paragraph":1},{"text":"A quel tempo una posa così rigida e frontale era riservata alle immagini sacre, soprattutto a quelle di Cristo.","start":10.867,"end":16.87,"words":[{"w":"A","start":10.867,"end":10.977},{"w":"quel","start":10.977,"end":11.249},{"w":"tempo","start":11.249,"end":11.577},{"w":"una","start":11.577,"end":11.795},{"w":"posa","start":11.795,"end":12.068},{"w":"così","start":12.068,"end":12.341},{"w":"rigida","start":12.341,"end":12.723},{"w":"e","start":12.723,"end":12.832},{"w":"frontale","start":12.832,"end":13.323},{"w":"era","start":13.323,"end":13.541},{"w":"riservata","start":13.541,"end":14.087},{"w":"alle","start":14.087,"end":14.36},{"w":"immagini","start":14.36,"end":14.851},{"w":"sacre","start":14.851,"end":15.178},{"w":"soprattutto","start":15.178,"end":15.833},{"w":"a","start":15.833,"end":15.942},{"w":"quelle","start":15.942,"end":16.324},{"w":"di","start":16.324,"end":16.488},{"w":"Cristo","start":16.488,"end":16.87}],"paragraph":1},{"text":"Anche la mia mano, appoggiata al bordo di pelliccia del mantello, ricorda il gesto di chi benedice.","start":17.32,"end":22.614,"words":[{"w":"Anche","start":17.32,"end":17.647},{"w":"la","start":17.647,"end":17.811},{"w":"mia","start":17.811,"end":18.029},{"w":"mano","start":18.029,"end":18.302},{"w":"appoggiata","start":18.302,"end":18.903},{"w":"al","start":18.903,"end":19.066},{"w":"bordo","start":19.066,"end":19.394},{"w":"di","start":19.394,"end":19.557},{"w":"pelliccia","start":19.557,"end":20.103},{"w":"del","start":20.103,"end":20.322},{"w":"mantello","start":20.322,"end":20.813},{"w":"ricorda","start":20.813,"end":21.249},{"w":"il","start":21.249,"end":21.413},{"w":"gesto","start":21.413,"end":21.741},{"w":"di","start":21.741,"end":21.904},{"w":"chi","start":21.904,"end":22.123},{"w":"benedice","start":22.123,"end":22.614}],"paragraph":1},{"text":"Accanto al mio viso ho scritto due cose.","start":23.514,"end":25.708,"words":[{"w":"Accanto","start":23.514,"end":23.953},{"w":"al","start":23.953,"end":24.117},{"w":"mio","start":24.117,"end":24.337},{"w":"viso","start":24.337,"end":24.611},{"w":"ho","start":24.611,"end":24.776},{"w":"scritto","start":24.776,"end":25.214},{"w":"due","start":25.214,"end":25.434},{"w":"cose","start":25.434,"end":25.708}],"paragraph":2},{"text":"A sinistra c'è la data, 1500, sopra le mie iniziali: una A e una D.","start":26.158,"end":31.127,"words":[{"w":"A","start":26.158,"end":26.313},{"w":"sinistra","start":26.313,"end":27.012},{"w":"c'è","start":27.012,"end":27.323},{"w":"la","start":27.323,"end":27.556},{"w":"data","start":27.556,"end":27.944},{"w":"1500","start":27.944,"end":28.332},{"w":"sopra","start":28.332,"end":28.798},{"w":"le","start":28.798,"end":29.031},{"w":"mie","start":29.031,"end":29.341},{"w":"iniziali","start":29.341,"end":30.04},{"w":"una","start":30.04,"end":30.351},{"w":"A","start":30.351,"end":30.506},{"w":"e","start":30.506,"end":30.661},{"w":"una","start":30.661,"end":30.972},{"w":"D","start":30.972,"end":31.127}],"paragraph":2},{"text":"A destra c'è una frase in latino.","start":31.577,"end":33.47,"words":[{"w":"A","start":31.577,"end":31.692},{"w":"destra","start":31.692,"end":32.093},{"w":"c'è","start":32.093,"end":32.323},{"w":"una","start":32.323,"end":32.552},{"w":"frase","start":32.552,"end":32.896},{"w":"in","start":32.896,"end":33.068},{"w":"latino","start":33.068,"end":33.47}],"paragraph":2},{"text":"Te la traduco: «Io, Albrecht Dürer di Norimberga, mi sono ritratto così, con i miei colori, all'età di ventotto anni».","start":33.92,"end":41.443,"words":[{"w":"Te","start":33.92,"end":34.123},{"w":"la","start":34.123,"end":34.326},{"w":"traduco","start":34.326,"end":34.869},{"w":"Io","start":34.869,"end":35.072},{"w":"Albrecht","start":35.072,"end":35.682},{"w":"Dürer","start":35.682,"end":36.089},{"w":"di","start":36.089,"end":36.292},{"w":"Norimberga","start":36.292,"end":37.037},{"w":"mi","start":37.037,"end":37.241},{"w":"sono","start":37.241,"end":37.58},{"w":"ritratto","start":37.58,"end":38.19},{"w":"così","start":38.19,"end":38.529},{"w":"con","start":38.529,"end":38.8},{"w":"i","start":38.8,"end":38.935},{"w":"miei","start":38.935,"end":39.274},{"w":"colori","start":39.274,"end":39.749},{"w":"all'età","start":39.749,"end":40.291},{"w":"di","start":40.291,"end":40.494},{"w":"ventotto","start":40.494,"end":41.104},{"w":"anni","start":41.104,"end":41.443}],"paragraph":2},{"text":"Nota che non ho scritto «ho dipinto»: ho usato una parola che vuol dire piuttosto «creare», «dare forma».","start":41.893,"end":47.501,"words":[{"w":"Nota","start":41.893,"end":42.182},{"w":"che","start":42.182,"end":42.413},{"w":"non","start":42.413,"end":42.644},{"w":"ho","start":42.644,"end":42.818},{"w":"scritto","start":42.818,"end":43.28},{"w":"ho","start":43.28,"end":43.454},{"w":"dipinto","start":43.454,"end":43.916},{"w":"ho","start":43.916,"end":44.09},{"w":"usato","start":44.09,"end":44.437},{"w":"una","start":44.437,"end":44.668},{"w":"parola","start":44.668,"end":45.073},{"w":"che","start":45.073,"end":45.304},{"w":"vuol","start":45.304,"end":45.593},{"w":"dire","start":45.593,"end":45.882},{"w":"piuttosto","start":45.882,"end":46.46},{"w":"creare","start":46.46,"end":46.865},{"w":"dare","start":46.865,"end":47.154},{"w":"forma","start":47.154,"end":47.501}],"paragraph":2},{"text":"Dopo la mia morte il ritratto rimase a Norimberga, nel palazzo del Comune.","start":48.401,"end":52.557,"words":[{"w":"Dopo","start":48.401,"end":48.685},{"w":"la","start":48.685,"end":48.856},{"w":"mia","start":48.856,"end":49.084},{"w":"morte","start":49.084,"end":49.425},{"w":"il","start":49.425,"end":49.596},{"w":"ritratto","start":49.596,"end":50.109},{"w":"rimase","start":50.109,"end":50.507},{"w":"a","start":50.507,"end":50.621},{"w":"Norimberga","start":50.621,"end":51.247},{"w":"nel","start":51.247,"end":51.475},{"w":"palazzo","start":51.475,"end":51.931},{"w":"del","start":51.931,"end":52.158},{"w":"Comune","start":52.158,"end":52.557}],"paragraph":3},{"text":"Nei primi anni dell'Ottocento passò alle collezioni reali di Baviera.","start":53.007,"end":56.374,"words":[{"w":"Nei","start":53.007,"end":53.202},{"w":"primi","start":53.202,"end":53.495},{"w":"anni","start":53.495,"end":53.739},{"w":"dell'Ottocento","start":53.739,"end":54.471},{"w":"passò","start":54.471,"end":54.764},{"w":"alle","start":54.764,"end":55.008},{"w":"collezioni","start":55.008,"end":55.544},{"w":"reali","start":55.544,"end":55.837},{"w":"di","start":55.837,"end":55.983},{"w":"Baviera","start":55.983,"end":56.374}],"paragraph":3},{"text":"Oggi mi trovi a Monaco, nell'Alte Pinakothek.","start":56.824,"end":59.366,"words":[{"w":"Oggi","start":56.824,"end":57.113},{"w":"mi","start":57.113,"end":57.286},{"w":"trovi","start":57.286,"end":57.633},{"w":"a","start":57.633,"end":57.748},{"w":"Monaco","start":57.748,"end":58.153},{"w":"nell'Alte","start":58.153,"end":58.731},{"w":"Pinakothek","start":58.731,"end":59.366}],"paragraph":3},{"text":"Se vuoi, fammi una domanda.","start":60.266,"end":61.845,"words":[{"w":"Se","start":60.266,"end":60.449},{"w":"vuoi","start":60.449,"end":60.752},{"w":"fammi","start":60.752,"end":61.117},{"w":"una","start":61.117,"end":61.36},{"w":"domanda","start":61.36,"end":61.845}],"paragraph":4}]}