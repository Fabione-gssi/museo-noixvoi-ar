{"source":"tts","voice":"piper it_IT-serena-medium","durationSec":62.2,"sentences":[{"text":"Sono Albrecht Dürer, di Norimberga.","start":0,"end":2.299,"words":[{"w":"Sono","start":0,"end":0.338},{"w":"Albrecht","start":0.338,"end":0.947},{"w":"Dürer","start":0.947,"end":1.352},{"w":"di","start":1.352,"end":1.555},{"w":"Norimberga","start":1.555,"end":2.299}],"paragraph":0},{"text":"Questo ritratto l'ho dipinto nel 1500, a olio su tavola.","start":2.749,"end":6.754,"words":[{"w":"Questo","start":2.749,"end":3.259},{"w":"ritratto","start":3.259,"end":3.914},{"w":"l'ho","start":3.914,"end":4.278},{"w":"dipinto","start":4.278,"end":4.861},{"w":"nel","start":4.861,"end":5.152},{"w":"1500","start":5.152,"end":5.516},{"w":"a","start":5.516,"end":5.662},{"w":"olio","start":5.662,"end":6.026},{"w":"su","start":6.026,"end":6.244},{"w":"tavola","start":6.244,"end":6.754}],"paragraph":0},{"text":"Mi vedi di fronte, mentre ti guardo dritto negli occhi.","start":7.654,"end":10.592,"words":[{"w":"Mi","start":7.654,"end":7.817},{"w":"vedi","start":7.817,"end":8.089},{"w":"di","start":8.089,"end":8.253},{"w":"fronte","start":8.253,"end":8.633},{"w":"mentre","start":8.633,"end":9.014},{"w":"ti","start":9.014,"end":9.177},{"w":"guardo","start":9.177,"end":9.558},{"w":"dritto","start":9.558,"end":9.939},{"w":"negli","start":9.939,"end":10.265},{"w":"occhi","start":10.265,"end":10.592}],"paragraph":1},{"text":"A quel tempo una posa così rigida e frontale era riservata alle immagini sacre, soprattutto a quelle di Cristo.","start":11.042,"end":17.148,"words":[{"w":"A","start":11.042,"end":11.153},{"w":"quel","start":11.153,"end":11.43},{"w":"tempo","start":11.43,"end":11.763},{"w":"una","start":11.763,"end":11.985},{"w":"posa","start":11.985,"end":12.263},{"w":"così","start":12.263,"end":12.54},{"w":"rigida","start":12.54,"end":12.929},{"w":"e","start":12.929,"end":13.04},{"w":"frontale","start":13.04,"end":13.54},{"w":"era","start":13.54,"end":13.762},{"w":"riservata","start":13.762,"end":14.317},{"w":"alle","start":14.317,"end":14.595},{"w":"immagini","start":14.595,"end":15.094},{"w":"sacre","start":15.094,"end":15.427},{"w":"soprattutto","start":15.427,"end":16.094},{"w":"a","start":16.094,"end":16.205},{"w":"quelle","start":16.205,"end":16.593},{"w":"di","start":16.593,"end":16.76},{"w":"Cristo","start":16.76,"end":17.148}],"paragraph":1},{"text":"Anche la mia mano, appoggiata al bordo di pelliccia del mantello, ricorda il gesto di chi benedice.","start":17.598,"end":22.753,"words":[{"w":"Anche","start":17.598,"end":17.917},{"w":"la","start":17.917,"end":18.077},{"w":"mia","start":18.077,"end":18.289},{"w":"mano","start":18.289,"end":18.555},{"w":"appoggiata","start":18.555,"end":19.14},{"w":"al","start":19.14,"end":19.299},{"w":"bordo","start":19.299,"end":19.618},{"w":"di","start":19.618,"end":19.777},{"w":"pelliccia","start":19.777,"end":20.309},{"w":"del","start":20.309,"end":20.521},{"w":"mantello","start":20.521,"end":21},{"w":"ricorda","start":21,"end":21.425},{"w":"il","start":21.425,"end":21.584},{"w":"gesto","start":21.584,"end":21.903},{"w":"di","start":21.903,"end":22.062},{"w":"chi","start":22.062,"end":22.275},{"w":"benedice","start":22.275,"end":22.753}],"paragraph":1},{"text":"Accanto al mio viso ho scritto due cose.","start":23.653,"end":25.697,"words":[{"w":"Accanto","start":23.653,"end":24.062},{"w":"al","start":24.062,"end":24.215},{"w":"mio","start":24.215,"end":24.419},{"w":"viso","start":24.419,"end":24.675},{"w":"ho","start":24.675,"end":24.828},{"w":"scritto","start":24.828,"end":25.237},{"w":"due","start":25.237,"end":25.441},{"w":"cose","start":25.441,"end":25.697}],"paragraph":2},{"text":"A sinistra c'è la data, 1500, sopra le mie iniziali: una A e una D.","start":26.147,"end":31.034,"words":[{"w":"A","start":26.147,"end":26.299},{"w":"sinistra","start":26.299,"end":26.987},{"w":"c'è","start":26.987,"end":27.292},{"w":"la","start":27.292,"end":27.521},{"w":"data","start":27.521,"end":27.903},{"w":"1500","start":27.903,"end":28.285},{"w":"sopra","start":28.285,"end":28.743},{"w":"le","start":28.743,"end":28.972},{"w":"mie","start":28.972,"end":29.278},{"w":"iniziali","start":29.278,"end":29.965},{"w":"una","start":29.965,"end":30.271},{"w":"A","start":30.271,"end":30.423},{"w":"e","start":30.423,"end":30.576},{"w":"una","start":30.576,"end":30.882},{"w":"D","start":30.882,"end":31.034}],"paragraph":2},{"text":"A destra c'è una frase in latino.","start":31.484,"end":33.226,"words":[{"w":"A","start":31.484,"end":31.59},{"w":"destra","start":31.59,"end":31.959},{"w":"c'è","start":31.959,"end":32.17},{"w":"una","start":32.17,"end":32.382},{"w":"frase","start":32.382,"end":32.698},{"w":"in","start":32.698,"end":32.856},{"w":"latino","start":32.856,"end":33.226}],"paragraph":2},{"text":"Te la traduco: «Io, Albrecht Dürer di Norimberga, mi sono ritratto così, con i miei colori, all'età di ventotto anni».","start":33.676,"end":40.746,"words":[{"w":"Te","start":33.676,"end":33.867},{"w":"la","start":33.867,"end":34.058},{"w":"traduco","start":34.058,"end":34.568},{"w":"Io","start":34.568,"end":34.759},{"w":"Albrecht","start":34.759,"end":35.332},{"w":"Dürer","start":35.332,"end":35.714},{"w":"di","start":35.714,"end":35.905},{"w":"Norimberga","start":35.905,"end":36.606},{"w":"mi","start":36.606,"end":36.797},{"w":"sono","start":36.797,"end":37.116},{"w":"ritratto","start":37.116,"end":37.689},{"w":"così","start":37.689,"end":38.007},{"w":"con","start":38.007,"end":38.262},{"w":"i","start":38.262,"end":38.39},{"w":"miei","start":38.39,"end":38.708},{"w":"colori","start":38.708,"end":39.154},{"w":"all'età","start":39.154,"end":39.663},{"w":"di","start":39.663,"end":39.855},{"w":"ventotto","start":39.855,"end":40.428},{"w":"anni","start":40.428,"end":40.746}],"paragraph":2},{"text":"Nota che non ho scritto «ho dipinto»: ho usato una parola che vuol dire piuttosto «creare», «dare forma».","start":41.196,"end":46.734,"words":[{"w":"Nota","start":41.196,"end":41.482},{"w":"che","start":41.482,"end":41.71},{"w":"non","start":41.71,"end":41.939},{"w":"ho","start":41.939,"end":42.11},{"w":"scritto","start":42.11,"end":42.567},{"w":"ho","start":42.567,"end":42.738},{"w":"dipinto","start":42.738,"end":43.195},{"w":"ho","start":43.195,"end":43.366},{"w":"usato","start":43.366,"end":43.708},{"w":"una","start":43.708,"end":43.937},{"w":"parola","start":43.937,"end":44.336},{"w":"che","start":44.336,"end":44.565},{"w":"vuol","start":44.565,"end":44.85},{"w":"dire","start":44.85,"end":45.136},{"w":"piuttosto","start":45.136,"end":45.707},{"w":"creare","start":45.707,"end":46.106},{"w":"dare","start":46.106,"end":46.392},{"w":"forma","start":46.392,"end":46.734}],"paragraph":2},{"text":"Dopo la mia morte il ritratto rimase a Norimberga, nel palazzo del Comune.","start":47.634,"end":51.628,"words":[{"w":"Dopo","start":47.634,"end":47.908},{"w":"la","start":47.908,"end":48.072},{"w":"mia","start":48.072,"end":48.291},{"w":"morte","start":48.291,"end":48.619},{"w":"il","start":48.619,"end":48.783},{"w":"ritratto","start":48.783,"end":49.276},{"w":"rimase","start":49.276,"end":49.659},{"w":"a","start":49.659,"end":49.768},{"w":"Norimberga","start":49.768,"end":50.37},{"w":"nel","start":50.37,"end":50.589},{"w":"palazzo","start":50.589,"end":51.026},{"w":"del","start":51.026,"end":51.245},{"w":"Comune","start":51.245,"end":51.628}],"paragraph":3},{"text":"Nei primi anni dell'Ottocento passò alle collezioni reali di Baviera.","start":52.078,"end":55.445,"words":[{"w":"Nei","start":52.078,"end":52.273},{"w":"primi","start":52.273,"end":52.566},{"w":"anni","start":52.566,"end":52.81},{"w":"dell'Ottocento","start":52.81,"end":53.542},{"w":"passò","start":53.542,"end":53.835},{"w":"alle","start":53.835,"end":54.079},{"w":"collezioni","start":54.079,"end":54.616},{"w":"reali","start":54.616,"end":54.908},{"w":"di","start":54.908,"end":55.055},{"w":"Baviera","start":55.055,"end":55.445}],"paragraph":3},{"text":"Oggi mi trovi a Monaco, nell'Alte Pinakothek.","start":55.895,"end":58.67,"words":[{"w":"Oggi","start":55.895,"end":56.21},{"w":"mi","start":56.21,"end":56.4},{"w":"trovi","start":56.4,"end":56.778},{"w":"a","start":56.778,"end":56.904},{"w":"Monaco","start":56.904,"end":57.345},{"w":"nell'Alte","start":57.345,"end":57.976},{"w":"Pinakothek","start":57.976,"end":58.67}],"paragraph":3},{"text":"Se vuoi, fammi una domanda.","start":59.57,"end":61.3,"words":[{"w":"Se","start":59.57,"end":59.769},{"w":"vuoi","start":59.769,"end":60.102},{"w":"fammi","start":60.102,"end":60.501},{"w":"una","start":60.501,"end":60.767},{"w":"domanda","start":60.767,"end":61.3}],"paragraph":4}]}