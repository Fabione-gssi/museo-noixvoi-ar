    "ajv": "^8.20.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "canvas": "file:./stubs/canvas"
  },
  "dependencies": {
    "mind-ar": "1.2.5",
    "three": "0.186.1"
  }
